<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <!-- Public GitHub Pages demo only — never part of the Home Assistant add-on/Docker build
         (see wattsup/Dockerfile, which deliberately does not COPY this project). -->
    <RootNamespace>WattsUp.Wasm</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.1" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.1" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" Version="10.9.0" />
    <PackageReference Include="MudBlazor" Version="9.9.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../WattsUp.Core/WattsUp.Core.csproj" />
  </ItemGroup>

  <!-- PWA: turns wwwroot/service-worker.js (dev, a no-op passthrough) into the real
       service-worker.published.js at publish time, and generates service-worker-assets.js (the
       hashed static-asset manifest the published worker caches for the app shell). Both the
       property and the item are required — the property alone doesn't wire anything up. -->
  <PropertyGroup>
    <ServiceWorkerAssetsManifest>service-worker-assets.js</ServiceWorkerAssetsManifest>
  </PropertyGroup>
  <ItemGroup>
    <ServiceWorker Include="wwwroot/service-worker.js" PublishedContent="wwwroot/service-worker.published.js" />
  </ItemGroup>

  <!-- GitHub Pages routing has no server-side rewrite: a direct load of e.g. /WattsUp/settings
       404s. Shipping a 404.html identical to index.html makes GH Pages serve the SPA there too —
       Blazor's client router then reads the real location.pathname and renders the right page. -->
  <Target Name="CopyIndexHtmlTo404" AfterTargets="Publish">
    <Copy SourceFiles="$(PublishDir)wwwroot/index.html" DestinationFiles="$(PublishDir)wwwroot/404.html" />
  </Target>

</Project>
