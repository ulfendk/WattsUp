@page "/secrets"
@using WattsUp.Wasm.Services
@inject AddonOptions AddonOptions
@inject IJSRuntime Js
@inject ISnackbar Snackbar

<PageTitle>WattsUp — Secrets</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">Secrets</MudText>

<MudAlert Severity="Severity.Info" Class="mb-4">
    <MudText Typo="Typo.subtitle1" Class="mb-2"><b>Your data stays in this browser</b></MudText>
    <MudText Typo="Typo.body2" Class="mb-2">
        This is the free public demo of WattsUp. There is no WattsUp server on the internet for this build —
        everything below runs entirely on your own device. Anything you enter here (your Eloverblik refresh
        token, or the Carnot API key field) is saved only in this browser's local storage. It is never sent to,
        or stored by, any WattsUp server, because none exists for this build. It's used for one thing only:
        letting <i>this browser</i> talk directly to eloverblik.dk on your behalf — exactly as if you'd typed
        your token into eloverblik.dk's own site.
    </MudText>
    <MudText Typo="Typo.body2" Class="mb-2">
        Clearing your browsing data, switching browsers or devices, or using a private/incognito window will
        lose these values. There is nothing to recover them from — by design, nobody but you ever has a copy.
    </MudText>
    <MudText Typo="Typo.body2">
        <b>Note:</b> eloverblik.dk may not allow web apps like this one to call it directly from a browser (a
        security policy called CORS, which only eloverblik.dk controls, not WattsUp). If that's the case, the
        metering-point and consumption features will show a clear error instead of data. Spot prices and tariff
        pricing are unaffected either way — those come from energidataservice.dk, a fully public, open dataset.
    </MudText>
</MudAlert>

<MudPaper Class="pa-4 mb-4" Outlined="true">
    <MudText Typo="Typo.h6" Class="mb-2">Eloverblik</MudText>
    <MudTextField T="string" Label="Refresh token"
                   @bind-Value="_eloverblikRefreshToken"
                   InputType="@(_showEloverblikToken ? InputType.Text : InputType.Password)"
                   Adornment="Adornment.End"
                   AdornmentIcon="@(_showEloverblikToken ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                   OnAdornmentClick="@(() => _showEloverblikToken = !_showEloverblikToken)"
                   HelperText="Generated at eloverblik.dk under Data access → Create token. Optional — enables the electric-heating annual-threshold calculation." />
</MudPaper>

<MudPaper Class="pa-4 mb-4" Outlined="true">
    <MudText Typo="Typo.h6" Class="mb-2">Carnot.dk</MudText>
    <MudTextField T="string" Label="API key"
                   @bind-Value="_carnotApiKey"
                   InputType="@(_showCarnotKey ? InputType.Text : InputType.Password)"
                   Adornment="Adornment.End"
                   AdornmentIcon="@(_showCarnotKey ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                   OnAdornmentClick="@(() => _showCarnotKey = !_showCarnotKey)"
                   HelperText="Reserved for a future price-prediction feature — not implemented yet, safe to leave empty." />
</MudPaper>

<MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync" Disabled="@_saving">Save</MudButton>

@code {
    private string _eloverblikRefreshToken = "";
    private string _carnotApiKey = "";
    private bool _showEloverblikToken;
    private bool _showCarnotKey;
    private bool _saving;

    protected override void OnInitialized()
    {
        // AddonOptions was already loaded from localStorage by Program.cs before this page could
        // render, so it just reflects the current singleton's state.
        _eloverblikRefreshToken = AddonOptions.EloverblikRefreshToken;
        _carnotApiKey = AddonOptions.CarnotApiKey;
    }

    private async Task SaveAsync()
    {
        _saving = true;
        try
        {
            // Mutate the shared singleton in place — every already-injected consumer (e.g.
            // EloverblikClient) sees this immediately, no reload needed.
            AddonOptions.EloverblikRefreshToken = _eloverblikRefreshToken;
            AddonOptions.CarnotApiKey = _carnotApiKey;
            await BrowserAddonOptionsStore.SaveAsync(Js, AddonOptions);
            Snackbar.Add("Saved — only in this browser.", Severity.Success);
        }
        finally
        {
            _saving = false;
        }
    }
}
