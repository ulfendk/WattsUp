@page "/not-found"
@layout WattsUp.Components.Layout.MainLayout
@implements IDisposable
@using WattsUp.Components.Shared

@if (!_giveUp)
{
    // On a cold first load the router can land here before the app has finished settling; if the
    // route resolves, this page is replaced by the real one, so show progress instead of an error.
    <FetchingPricesIndicator />
}
else
{
    <h3>Not Found</h3>
    <p>Sorry, the content you are looking for does not exist.</p>
}

@code {
    private static readonly TimeSpan GracePeriod = TimeSpan.FromSeconds(15);

    private bool _giveUp;
    private Timer? _timer;

    protected override void OnInitialized()
    {
        _timer = new Timer(_ => InvokeAsync(() =>
        {
            _giveUp = true;
            StateHasChanged();
        }), null, GracePeriod, Timeout.InfiniteTimeSpan);
    }

    public void Dispose() => _timer?.Dispose();
}
