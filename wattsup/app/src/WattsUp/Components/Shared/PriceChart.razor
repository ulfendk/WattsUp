<MudChart T="double" ChartType="ChartType.Line" ChartSeries="@_series" ChartLabels="@_labels"
          ChartOptions="@_options" Width="100%" Height="300px" />

@code {
    [Parameter, EditorRequired]
    public IReadOnlyList<(DateTimeOffset AtLocal, decimal TotalDkkPerKwh)> Points { get; set; } = [];

    private List<ChartSeries<double>> _series = [];
    private string[] _labels = [];
    // LineChartOptions (not the plain ChartOptions, which has no axis controls at all): YAxisTicks
    // sets the step between horizontal gridlines, which MudBlazor 9.9 otherwise defaults to a fixed
    // 20 regardless of the data's actual range — for DKK/kWh values that are normally well under
    // 20, that squashes the whole line into an unreadable sliver at the bottom of the chart
    // (backlog item 10's "garbled" chart bug: the line was technically there, just visually
    // flattened to near-nothing, with only "0" and "20" as gridlines). YAxisTicks is int-only, so 1
    // DKK/kWh is the finest step available; still far more legible than the default 20. Palette
    // matches MainLayout's theme (item 8) — MudBlazor's own default starts with a purple this app
    // avoids everywhere else.
    private readonly LineChartOptions _options = new()
    {
        ShowLegend = false,
        ChartPalette = ["#03A9F4"],
        YAxisTicks = 1,
        XAxisLabelRotation = -45,
    };

    protected override void OnParametersSet()
    {
        // MudChart renders every label with no auto-thinning — cramming a full "HH:mm" string per
        // point onto the x-axis overlaps into unreadable, "garbled" text (backlog item 10). Label
        // roughly every 6 hours, rotated, so consecutive labels don't run into each other. The
        // stride is derived from the actual point spacing rather than hardcoded, because
        // Denmark's day-ahead prices moved from hourly to 15-minute resolution — hardcoding "every
        // 6th point" assuming hourly data would silently go back to labeling every 1.5 hours (4x
        // too dense) the moment the API's resolution changes again.
        var pointsPerHour = PointsPerHour();
        var labelStride = Math.Max(1, pointsPerHour * 6);
        _labels = Points.Select((p, i) => i % labelStride == 0 ? p.AtLocal.ToString("HH:mm") : "").ToArray();
        _series =
        [
            new ChartSeries<double>
            {
                Name = "DKK/kWh",
                Data = Points.Select(p => (double)p.TotalDkkPerKwh).ToArray(),
            },
        ];
    }

    private int PointsPerHour()
    {
        if (Points.Count < 2)
        {
            return 1;
        }

        var deltaHours = (Points[1].AtLocal - Points[0].AtLocal).TotalHours;
        return deltaHours > 0 ? Math.Max(1, (int)Math.Round(1.0 / deltaHours)) : 1;
    }
}
