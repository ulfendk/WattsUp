<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="@BaseHref" />
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["css/app.css"]" />
    <link rel="stylesheet" href="@Assets["MudBlazor.min.css"]" />
    <link rel="stylesheet" href="@Assets["WattsUp.styles.css"]" />
    <ImportMap />
    <HeadOutlet />
</head>

<body>
    <Routes @rendermode="InteractiveServer" />
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script src="@Assets["_content/MudBlazor/MudBlazor.min.js"]"></script>
</body>

</html>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    // Reflects the PathBase IngressPathBaseMiddleware set from HA's X-Ingress-Path header, so
    // static assets, blazor.web.js, and the SignalR negotiate URL all resolve under the ingress
    // prefix. Empty PathBase (plain `dotnet run`, no ingress) yields the normal "/".
    private string BaseHref
    {
        get
        {
            var pathBase = HttpContext?.Request.PathBase.Value ?? "";
            return pathBase == "" ? "/" : pathBase + "/";
        }
    }
}
