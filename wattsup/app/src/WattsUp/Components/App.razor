@using Microsoft.AspNetCore.Localization
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="@BaseHref" />
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["css/app.css"]" />
    <link rel="stylesheet" href="@Assets["_content/MudBlazor/MudBlazor.min.css"]" />
    <link rel="stylesheet" href="@Assets["WattsUp.styles.css"]" />
    <ImportMap />
    <HeadOutlet />
    @if (NeedsCultureDetection)
    {
        <script>
            (function () {
                var culture = navigator.language || 'en-US';
                // location.pathname/search/hash already include any Home Assistant ingress prefix —
                // only the /culture/set target itself needs @@BaseHref prepended.
                var redirect = location.pathname + location.search + location.hash;
                location.replace('@BaseHref' + 'culture/set?culture=' + encodeURIComponent(culture) + '&redirectUri=' + encodeURIComponent(redirect));
            })();
        </script>
    }
</head>

<body>
    <Routes @rendermode="InteractiveServer" />
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script src="@Assets["_content/MudBlazor/MudBlazor.min.js"]"></script>
    <script src="@Assets["theme.js"]"></script>
</body>

</html>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    // Reflects the PathBase IngressPathBaseMiddleware set from HA's X-Ingress-Path header, so
    // static assets, blazor.web.js, and the SignalR negotiate URL all resolve under the ingress
    // prefix. Empty PathBase (plain `dotnet run`, no ingress) yields the normal "/".
    private string BaseHref
    {
        get
        {
            var pathBase = HttpContext?.Request.PathBase.Value ?? "";
            return pathBase == "" ? "/" : pathBase + "/";
        }
    }

    // Client-locale number formatting (backlog item 6): only inject the browser-locale-detection
    // redirect once — once /culture/set has stamped the cookie, RequestLocalizationMiddleware picks
    // it up on every later request and this stays false, so no repeat round trip.
    private bool NeedsCultureDetection =>
        HttpContext?.Request.Cookies[CookieRequestCultureProvider.DefaultCookieName] is null;
}
