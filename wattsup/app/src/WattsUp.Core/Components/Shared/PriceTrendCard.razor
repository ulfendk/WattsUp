@using System.Globalization
<MudCard Outlined="true">
    <MudCardHeader>
        <CardHeaderContent>
            <MudText Typo="Typo.h6">Trends</MudText>
        </CardHeaderContent>
    </MudCardHeader>
    <MudCardContent>
        @if (HourOverHour is not null)
        {
            <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-3">
                <MudIcon Icon="@TrendIcon" Color="@TrendColor" />
                <MudText Typo="Typo.body1">
                    @Fmt(HourOverHour.DeltaPercent, "N1")% vs. previous hour (@Fmt(HourOverHour.PreviousHourTotalDkkPerKwh) DKK/kWh)
                </MudText>
            </MudStack>
        }

        @if (TodayRange is not null)
        {
            <MudText Typo="Typo.body2" Class="mb-1">Today's range</MudText>
            var span = TodayRange.MaxDkkPerKwh - TodayRange.MinDkkPerKwh;
            var positionPercent = span <= 0m ? 50m : (TodayRange.CurrentDkkPerKwh - TodayRange.MinDkkPerKwh) / span * 100m;
            <div class="wattsup-range-track">
                <div class="wattsup-range-marker" style="left: @(Math.Clamp(positionPercent, 0m, 100m).ToString("0.##", CultureInfo.InvariantCulture))%;"></div>
            </div>
            <MudStack Row="true" Justify="Justify.SpaceBetween" Class="mb-3">
                <MudText Typo="Typo.caption">Low @Fmt(TodayRange.MinDkkPerKwh)</MudText>
                <MudText Typo="Typo.caption">Now @Fmt(TodayRange.CurrentDkkPerKwh)</MudText>
                <MudText Typo="Typo.caption">High @Fmt(TodayRange.MaxDkkPerKwh)</MudText>
            </MudStack>
        }

        @if (SameHour is not null)
        {
            <MudText Typo="Typo.body2">This hour vs. last @(SameHour.DaysCompared)-day avg: @Fmt(SameHour.TodayDkkPerKwh) vs. @Fmt(SameHour.AverageOverPastDaysDkkPerKwh) DKK/kWh</MudText>
        }

        @if (AverageComparison is not null)
        {
            <MudText Typo="Typo.body2">Today's avg. vs. last @(AverageComparison.DaysCompared)-day avg: @Fmt(AverageComparison.TodayAverageDkkPerKwh) vs. @Fmt(AverageComparison.AverageOverPastDaysDkkPerKwh) DKK/kWh</MudText>
        }
    </MudCardContent>
</MudCard>

<style>
    .wattsup-range-track { position: relative; height: 8px; border-radius: 4px; background: linear-gradient(to right, var(--mud-palette-success), var(--mud-palette-warning), var(--mud-palette-error)); margin: 4px 0; }
    .wattsup-range-marker { position: absolute; top: -3px; width: 3px; height: 14px; background: var(--mud-palette-text-primary); border-radius: 1px; transform: translateX(-1.5px); }
</style>

@code {
    [Parameter]
    public HourOverHourTrend? HourOverHour { get; set; }

    [Parameter]
    public TodayPriceRange? TodayRange { get; set; }

    [Parameter]
    public SameHourComparison? SameHour { get; set; }

    [Parameter]
    public AverageComparison? AverageComparison { get; set; }

    private string TrendIcon => HourOverHour!.DeltaPercent switch
    {
        > 1m => Icons.Material.Filled.TrendingUp,
        < -1m => Icons.Material.Filled.TrendingDown,
        _ => Icons.Material.Filled.TrendingFlat,
    };

    private Color TrendColor => HourOverHour!.DeltaPercent switch
    {
        > 1m => Color.Error,
        < -1m => Color.Success,
        _ => Color.Default,
    };

    private static string Fmt(decimal value, string format = "N4") => value.ToString(format, CultureInfo.CurrentCulture);
}
