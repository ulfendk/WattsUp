<MudChart T="double" ChartType="ChartType.Timeseries" ChartSeries="@_series"
          ChartOptions="@_options" Width="100%" Height="300px" />

@code {
    [Parameter, EditorRequired]
    public IReadOnlyList<(DateTimeOffset AtLocal, decimal TotalDkkPerKwh)> Points { get; set; } = [];

    private List<ChartSeries<double>> _series = [];

    // Timeseries (not the plain Line chart): each point carries its own real DateTime instead of a
    // parallel string-label array, which fixes two things at once. (1) Hovering a point now shows
    // its actual date/time in the tooltip (TooltipTitleFormat defaults to "{{X_VALUE}}", formatted
    // via TooltipTimeLabelFormat below) for every point, not just the ones with a visible axis
    // label. (2) X-axis label spacing is driven by TimeLabelSpacing (a real TimeSpan) rather than
    // "every Nth data point", so it no longer needs to guess the source data's resolution to avoid
    // overlapping into unreadable text (backlog item 10) — it stays correct even though Denmark's
    // day-ahead prices are now 15-minute resolution instead of hourly. YAxisTicks is still needed:
    // MudBlazor's Y-axis auto-scale otherwise defaults to a step of 20 regardless of the data's
    // actual (much smaller) DKK/kWh range. Palette matches MainLayout's theme (item 8).
    private readonly TimeSeriesChartOptions _options = new()
    {
        ShowLegend = false,
        ChartPalette = ["#03A9F4"],
        YAxisTicks = 1,
        XAxisLabelRotation = -45,
        TimeLabelSpacing = TimeSpan.FromHours(6),
        TimeLabelFormat = "HH:mm",
        TooltipTimeLabelFormat = "ddd HH:mm",
    };

    protected override void OnParametersSet()
    {
        _series =
        [
            new ChartSeries<double>
            {
                Name = "DKK/kWh",
                TooltipYValueFormat = "0.0000",
                Data = Points.Select(p => (p.AtLocal.DateTime, (double)p.TotalDkkPerKwh)).ToList(),
            },
        ];
    }
}
