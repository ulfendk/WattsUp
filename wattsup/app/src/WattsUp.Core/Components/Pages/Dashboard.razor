@page "/"
@implements IDisposable
@using WattsUp.BackgroundServices
@using WattsUp.Services
@inject ISettingsService SettingsService
@inject IPriceCalculationService PriceCalculationService
@inject IPriceTrendService PriceTrendService
@inject ISpotPriceRepository SpotPriceRepository
@inject DiagnosticsStatusService DiagnosticsStatus
@inject IDataRefreshCoordinator DataRefreshCoordinator
@inject IRuntimeInfo RuntimeInfo
@inject NavigationManager NavigationManager

<PageTitle>WattsUp — Dashboard</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">Dashboard</MudText>

@if (_loading)
{
    <MudProgressCircular Indeterminate="true" />
}
else if (string.IsNullOrWhiteSpace(_priceArea))
{
    <MudAlert Severity="Severity.Info">
        No price area is tracked yet. Head to <MudLink Href="settings">Settings</MudLink> to pick DK1 or DK2.
    </MudAlert>
}
else
{
    <MudStack Row="true" Class="mb-4" Wrap="Wrap.Wrap" Spacing="2">
        <StalenessBadge Label="Spot prices" Status="@DiagnosticsStatus.SpotPricePoll" WarnAfter="TimeSpan.FromHours(2)" StaleAfter="TimeSpan.FromHours(26)" />
        <StalenessBadge Label="Tariffs" Status="@DiagnosticsStatus.TariffPoll" WarnAfter="TimeSpan.FromDays(2)" StaleAfter="TimeSpan.FromDays(3)" />
    </MudStack>

    @if (!HasCurrentData && DiagnosticsStatus.SpotPriceFetching)
    {
        <FetchingPricesIndicator />
    }

    @if (_breakdown is not null)
    {
        <MudGrid>
            <MudItem xs="12" sm="6" md="4">
                <PriceBreakdownCard PriceArea="@_priceArea" Breakdown="@_breakdown" />
            </MudItem>
            <MudItem xs="12" sm="6" md="4">
                <CheapestPeriodsCard Periods="@_cheapestPeriods" />
            </MudItem>
            <MudItem xs="12" sm="6" md="4">
                <PriceTrendCard HourOverHour="@_hourOverHourTrend" TodayRange="@_todayRange" SameHour="@_sameHourComparison" AverageComparison="@_averageComparison" />
            </MudItem>
        </MudGrid>
    }

    <MudText Typo="Typo.h5" Class="mt-6 mb-2">Upcoming prices</MudText>
    @if (_chartPoints.Count > 0)
    {
        <MudGrid>
            <MudItem xs="12" md="4">
                <HourlyPricesCard Hours="@_hourlyPrices" />
            </MudItem>
            <MudItem xs="12" md="8">
                <PriceChart Points="@_chartPoints" />
            </MudItem>
        </MudGrid>
    }
    else if (!DiagnosticsStatus.SpotPriceFetching)
    {
        <MudAlert Severity="Severity.Info" Class="mt-2">No price data cached yet for @_priceArea — the poller runs on startup and hourly.</MudAlert>
    }
}

@code {
    private bool _loading = true;
    private string? _priceArea;
    private PriceBreakdown? _breakdown;
    private List<(DateTimeOffset, decimal)> _chartPoints = [];
    private IReadOnlyList<CheapestPeriodResult> _cheapestPeriods = [];
    private IReadOnlyList<HourlyPrice> _hourlyPrices = [];
    private HourOverHourTrend? _hourOverHourTrend;
    private TodayPriceRange? _todayRange;
    private SameHourComparison? _sameHourComparison;
    private AverageComparison? _averageComparison;
    private Timer? _refreshTimer;

    // "Current" = we can price right now and the cached series reaches at least the present.
    // Hourly-or-finer slots mean a series ending more than an hour ago has nothing for now.
    private bool HasCurrentData =>
        _breakdown is not null
        && _chartPoints.Count > 0
        && _chartPoints.Max(p => p.Item1) > DateTimeOffset.UtcNow.AddHours(-1);

    protected override async Task OnInitializedAsync()
    {
        if (RuntimeInfo.IsBrowserHosted)
        {
            var settings = await SettingsService.GetAsync();
            if (string.IsNullOrWhiteSpace(settings.GridCompanyGln))
            {
                // First-ever visit to the public demo (or Settings was never completed) — force
                // the visitor there instead of showing an empty/wrong-region dashboard. PriceArea
                // alone can't detect this: it defaults to "DK1" even though nobody has actually
                // confirmed that's the visitor's real region, but GridCompanyGln has no default
                // and is only ever set by saving Settings once.
                NavigationManager.NavigateTo("settings");
                return;
            }
        }

        await RefreshAsync();
        _loading = false;

        // Keep the dashboard live without requiring a manual refresh.
        _refreshTimer = new Timer(async _ => await InvokeAsync(async () =>
        {
            await RefreshAsync();
            StateHasChanged();
        }), null, TimeSpan.FromMinutes(1), TimeSpan.FromMinutes(1));

        SettingsService.SettingsChanged += OnSettingsChanged;
        DataRefreshCoordinator.Refreshed += OnDataRefreshed;
        DiagnosticsStatus.SpotPriceFetchingChanged += OnFetchingChanged;
    }

    private async Task RefreshAsync()
    {
        var settings = await SettingsService.GetAsync();
        _priceArea = settings.PriceArea;

        if (string.IsNullOrWhiteSpace(_priceArea))
        {
            _breakdown = null;
            _chartPoints = [];
            _cheapestPeriods = [];
            _hourlyPrices = [];
            _hourOverHourTrend = null;
            _todayRange = null;
            _sameHourComparison = null;
            _averageComparison = null;
            return;
        }

        var nowUtc = DateTimeOffset.UtcNow;
        _breakdown = await PriceCalculationService.CalculateAsync(_priceArea, nowUtc);

        var localNow = TimeZoneInfo.ConvertTime(nowUtc, WattsUp.Services.Tariffs.TariffResolutionService.CopenhagenTimeZone);
        var localMidnight = new DateTimeOffset(localNow.Date, localNow.Offset);
        var fromUtc = localMidnight.ToUniversalTime();
        var toUtc = fromUtc.AddDays(2);

        var spotPrices = (await SpotPriceRepository.GetRangeAsync(_priceArea, fromUtc, toUtc)).ToList();
        // Drop slots that are already over: keep the slot containing "now" (the latest one that
        // started at or before now) and everything after it.
        var currentSlotStart = spotPrices.Where(sp => sp.TimeUtc <= nowUtc).Select(sp => (DateTimeOffset?)sp.TimeUtc).Max();
        if (currentSlotStart is not null)
        {
            spotPrices = spotPrices.Where(sp => sp.TimeUtc >= currentSlotStart).ToList();
        }
        var points = new List<(DateTimeOffset, decimal)>();
        var utcPoints = new List<(DateTimeOffset AtUtc, decimal TotalDkkPerKwh)>();
        foreach (var spot in spotPrices)
        {
            var breakdown = await PriceCalculationService.CalculateAsync(_priceArea, spot.TimeUtc);
            var local = TimeZoneInfo.ConvertTime(spot.TimeUtc, WattsUp.Services.Tariffs.TariffResolutionService.CopenhagenTimeZone);
            points.Add((local, breakdown.TotalDkkPerKwh));
            utcPoints.Add((spot.TimeUtc, breakdown.TotalDkkPerKwh));
        }
        _chartPoints = points;
        // Contiguity checks use UTC, not the localized display times above, so a DST transition
        // (a 23- or 25-hour local day) can't be mistaken for a gap in the hourly data.
        _cheapestPeriods = CheapestPeriodCalculator.FindCheapestPeriods(utcPoints, [1, 2, 3, 4, 5, 6]);
        // Average each (UTC-aligned; Copenhagen offsets are whole hours) hour over its remaining slots.
        _hourlyPrices = utcPoints
            .GroupBy(p => new DateTimeOffset(p.AtUtc.UtcDateTime.Date.AddHours(p.AtUtc.UtcDateTime.Hour), TimeSpan.Zero))
            .OrderBy(g => g.Key)
            .Select(g => new HourlyPrice(
                TimeZoneInfo.ConvertTime(g.Key, WattsUp.Services.Tariffs.TariffResolutionService.CopenhagenTimeZone),
                g.Average(x => x.TotalDkkPerKwh),
                g.OrderBy(x => x.AtUtc).Select(x => new QuarterPrice(x.AtUtc.UtcDateTime.Minute, x.TotalDkkPerKwh)).ToList()))
            .ToList();

        _hourOverHourTrend = await PriceTrendService.GetHourOverHourTrendAsync(_priceArea, nowUtc);
        _todayRange = await PriceTrendService.GetTodayRangeAsync(_priceArea, nowUtc);
        _sameHourComparison = await PriceTrendService.GetSameHourLastNDaysAsync(_priceArea, nowUtc);
        _averageComparison = await PriceTrendService.GetTodayVsLastNDaysAverageAsync(_priceArea, nowUtc);
    }

    private void OnSettingsChanged() => InvokeAsync(async () =>
    {
        await RefreshAsync();
        StateHasChanged();
    });

    // A finished fetch has written new rows, so re-read them; a starting one just needs a repaint.
    private void OnFetchingChanged() => InvokeAsync(async () =>
    {
        if (!DiagnosticsStatus.SpotPriceFetching)
        {
            await RefreshAsync();
        }
        StateHasChanged();
    });

    private void OnDataRefreshed() => InvokeAsync(async () =>
    {
        await RefreshAsync();
        StateHasChanged();
    });

    public void Dispose()
    {
        _refreshTimer?.Dispose();
        SettingsService.SettingsChanged -= OnSettingsChanged;
        DataRefreshCoordinator.Refreshed -= OnDataRefreshed;
        DiagnosticsStatus.SpotPriceFetchingChanged -= OnFetchingChanged;
    }
}
