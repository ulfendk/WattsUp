@inherits LayoutComponentBase
@using MudBlazor.Services
@using WattsUp.BackgroundServices
@using WattsUp.Services
@implements IAsyncDisposable
@inject IBrowserViewportService BrowserViewportService
@inject IJSRuntime JsRuntime
@inject IThemePreferenceStore ThemePreferenceStore
@inject IRuntimeInfo RuntimeInfo
@inject IPwaInstallService PwaInstallService
@inject IDataRefreshCoordinator DataRefreshCoordinator
@inject ISnackbar Snackbar

<MudThemeProvider Theme="_theme" @bind-IsDarkMode="_isDarkMode" />
<MudPopoverProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="@ToggleDrawer" />
        <MudIcon Icon="@Icons.Material.Filled.Bolt" Class="mr-2" />
        <MudText Typo="Typo.h6">WattsUp</MudText>
        <MudSpacer />
        @if (RuntimeInfo.IsBrowserHosted)
        {
            <MudTooltip Text="Refresh prices, tariffs &amp; consumption now">
                <MudIconButton Icon="@Icons.Material.Filled.Refresh" Color="Color.Inherit"
                                OnClick="@RefreshDataAsync" Disabled="@_refreshing" />
            </MudTooltip>
        }
        @if (_installAvailable)
        {
            <MudTooltip Text="Install WattsUp as an app">
                <MudIconButton Icon="@Icons.Material.Filled.InstallMobile" Color="Color.Inherit" OnClick="@PromptInstallAsync" />
            </MudTooltip>
        }
        <MudIconButton Icon="@(_isDarkMode ? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode)"
                        Color="Color.Inherit" OnClick="@ToggleDarkModeAsync" />
    </MudAppBar>
    <MudDrawer @bind-Open="_drawerOpen" ClipMode="DrawerClipMode.Always" Elevation="1"
               Variant="@DrawerVariant.Responsive" Breakpoint="Breakpoint.Md">
        <NavMenu />
    </MudDrawer>
    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.Large" Class="my-4 pt-4">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    // Loosely echoes Home Assistant's own Material palette (its default primary blue) so the app
    // doesn't feel like a foreign tool bolted onto an HA dashboard — matches the sibling
    // "timetracker" repo's basic colours (backlog item 8), not MudBlazor's default purple.
    private readonly MudTheme _theme = new()
    {
        PaletteLight = new PaletteLight
        {
            Primary = "#03A9F4",
            AppbarBackground = "#03A9F4",
            // MudBlazor's default Secondary is a bright pink - overridden here to a plain gray,
            // since we only use Color.Secondary for muted helper text, never as an accent.
            Secondary = "#616161",
        },
        PaletteDark = new PaletteDark
        {
            Primary = "#03A9F4",
            Secondary = "#9E9E9E",
        },
    };

    // Full drawer, always open, on desktop (Md and up); a fully-hidden off-canvas overlay toggled
    // by the burger button below that ("Responsive" = Persistent above the breakpoint, Temporary
    // below it). MudDrawer's own Breakpoint parameter only affects how it BEHAVES (persistent vs.
    // overlay), not its initial Open state - without this subscription it stays fully expanded
    // (and thus covering the page) on first load on a phone, so the actual open/closed default has
    // to be driven from the real viewport size explicitly.
    private bool _drawerOpen = true;
    private readonly Guid _viewportSubscriptionId = Guid.NewGuid();

    // Dark mode: an explicit user choice (via the app-bar toggle) is persisted via
    // IThemePreferenceStore and always wins; absent that, we follow the browser's own
    // prefers-color-scheme on first render. The Server host backs the store with
    // ProtectedLocalStorage (its own Data Protection keys, persisted under /data, so the choice
    // survives container restarts/upgrades); the WASM host backs it with plain localStorage.
    private bool _isDarkMode;

    // "Install app" button state — mirrors IPwaInstallService.IsInstallAvailable, which is false
    // (and stays false) for the whole lifetime of the Server/add-on build's NullPwaInstallService.
    private bool _installAvailable;

    // Manual refresh (WASM build only — see the RuntimeInfo.IsBrowserHosted guard above).
    private bool _refreshing;

    protected override async Task OnInitializedAsync()
    {
        await BrowserViewportService.SubscribeAsync(_viewportSubscriptionId, OnResizedAsync, new ResizeOptions(), fireImmediately: true);
        PwaInstallService.AvailabilityChanged += OnInstallAvailabilityChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        _isDarkMode = await ThemePreferenceStore.TryGetDarkModeAsync() ?? await JsRuntime.InvokeAsync<bool>("themeInterop.prefersDark");
        await PwaInstallService.InitializeAsync();
        _installAvailable = PwaInstallService.IsInstallAvailable;
        StateHasChanged();
    }

    private void OnInstallAvailabilityChanged() => InvokeAsync(() =>
    {
        _installAvailable = PwaInstallService.IsInstallAvailable;
        StateHasChanged();
    });

    private async Task PromptInstallAsync() => await PwaInstallService.PromptInstallAsync();

    private async Task RefreshDataAsync()
    {
        _refreshing = true;
        try
        {
            await DataRefreshCoordinator.RefreshNowAsync();
            Snackbar.Add("Data refreshed.", Severity.Success);
        }
        catch (Exception)
        {
            // Each poller already reports its own failure to DiagnosticsStatusService and keeps
            // last-known-good cached data — this only catches something outside that (e.g. an
            // IndexedDB hiccup), so a generic message is enough; see Diagnostics for specifics.
            Snackbar.Add("Refresh failed — check the Diagnostics page for details.", Severity.Warning);
        }
        finally
        {
            _refreshing = false;
        }
    }

    private async Task ToggleDarkModeAsync()
    {
        _isDarkMode = !_isDarkMode;
        await ThemePreferenceStore.SetDarkModeAsync(_isDarkMode);
    }

    private async Task OnResizedAsync(BrowserViewportEventArgs args)
    {
        // Note the argument order: (rangeToTestAgainst, actualCurrentBreakpoint) - passing these
        // the other way round silently answers a different question and always returns false for
        // anything at or above Md.
        _drawerOpen = await BrowserViewportService.IsBreakpointWithinReferenceSizeAsync(Breakpoint.MdAndUp, args.Breakpoint);
        await InvokeAsync(StateHasChanged);
    }

    private void ToggleDrawer() => _drawerOpen = !_drawerOpen;

    public async ValueTask DisposeAsync()
    {
        PwaInstallService.AvailabilityChanged -= OnInstallAvailabilityChanged;
        await BrowserViewportService.UnsubscribeAsync(_viewportSubscriptionId);
    }
}
