<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <!-- Keep folder-based Razor namespace inference producing "WattsUp.Components.*" (matching
         every existing @page/@using and the WattsUp/WattsUp.Wasm hosts' _Imports.razor) instead of
         the "WattsUp.Core.*" the project name would otherwise imply. -->
    <RootNamespace>WattsUp</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.1" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.1" />
    <PackageReference Include="MudBlazor" Version="9.9.0" />
  </ItemGroup>

  <!-- Sdk.Razor doesn't auto-include the ASP.NET-specific implicit usings that Sdk.Web (the
       WattsUp/WattsUp.Wasm hosts) gets for free; add back the ones the moved code relies on
       (ILogger<>, IServiceScopeFactory, BackgroundService) so file content didn't need touching. -->
  <ItemGroup>
    <Using Include="Microsoft.Extensions.DependencyInjection" />
    <Using Include="Microsoft.Extensions.Hosting" />
    <Using Include="Microsoft.Extensions.Logging" />
  </ItemGroup>

</Project>
